# Copy to `.env` only if a tool needs root-level vars. Prefer per-app `.env`.

NODE_ENV=development

# Postgres (Compose) — required for Phase 1 identity
DATABASE_URL=postgresql://tessera:tessera@localhost:5432/tessera

# Auth. JWT_ACCESS_SECRET also signs STORAGE_DRIVER=fs media URLs.
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-32+
TOTP_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
COOKIE_SECURE=false
WEB_ORIGIN=http://localhost:3000
ADMIN_ORIGIN=http://localhost:3002
API_PUBLIC_URL=http://localhost:3001

# Redis
REDIS_URL=redis://localhost:6379

# MinIO (S3-compatible)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=tessera
S3_SECRET_KEY=tessera-minio
S3_BUCKET=tessera-media

# Meilisearch (people, hashtags, places, captions). Unset = Postgres search fallback.
MEILI_HOST=http://localhost:7700
MEILI_API_KEY=tessera_meili_dev_key_change_me

# Mailpit SMTP
SMTP_HOST=localhost
SMTP_PORT=1025

# Observability — leave blank. Phase 0 is a labelled no-op.
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=

# AI (SpaceXAI / xAI) — alt-text drafts. Leave blank for 501 ALT_SUGGEST_NOT_CONFIGURED.
XAI_API_KEY=

# Loop auto-captions. Default is labelled CAPTIONS_NOT_CONFIGURED (not faked).
# CAPTION_PROVIDER=fixture   # tests only
# WHISPER_BIN=               # reserved; currently labelled WHISPER_NOT_WIRED

# Push. Leave blank locally — delivery is labelled SOFT-FAIL; tokens still store.
# EXPO_ACCESS_TOKEN=
# PUSH_DRIVER=live
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:noreply@localhost

# Tests/CI without MinIO:
# STORAGE_DRIVER=fs
# MEDIA_PROCESS=inline
