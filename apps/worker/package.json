{
  "name": "@tessera/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json --noEmit",
    "start": "tsx src/main.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "pnpm --dir ../.. exec eslint --max-warnings 0 apps/worker"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@prisma/adapter-pg": "7.10.0",
    "@tessera/db": "workspace:*",
    "@tessera/media": "workspace:*",
    "bullmq": "^5.58.5",
    "dotenv": "^16.6.1",
    "ioredis": "^5.7.0",
    "nodemailer": "^7.0.6",
    "pino": "^9.9.0",
    "pino-pretty": "^13.1.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/nodemailer": "^7.0.1",
    "tsx": "^4.20.5",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
