PORT=3001
NODE_ENV=development
LOG_LEVEL=info

# Compose Postgres from Phase 0
DATABASE_URL=postgresql://tessera:tessera@localhost:5432/tessera

# Optional. Rate limits fall back to memory with a SOFT-FAIL log if Redis is down.
REDIS_URL=redis://localhost:6379

# Signs access tokens. Also the HMAC key for STORAGE_DRIVER=fs media URLs (`exp` + `sig`).
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-32+
# 32 bytes as 64 hex characters. Used to encrypt TOTP secrets at rest.
TOTP_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

COOKIE_SECURE=false
WEB_ORIGIN=http://localhost:3000
ADMIN_ORIGIN=http://localhost:3002
API_PUBLIC_URL=http://localhost:3001
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3100,http://127.0.0.1:3100

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=Tessera <noreply@localhost>

# Object storage. MinIO from Compose, or STORAGE_DRIVER=fs for tests/CI.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=tessera
S3_SECRET_KEY=tessera-minio
S3_BUCKET=tessera-media
# STORAGE_DRIVER=fs
# STORAGE_FS_ROOT=.tessera-storage
# MEDIA_PROCESS=inline   # skip BullMQ; process in the API (tests/CI)

# Alt-text drafts (SpaceXAI). Leave blank — POST /v1/media/:id/suggest-alt returns 501.
XAI_API_KEY=

# Loop captions. Default skips with CAPTIONS_NOT_CONFIGURED (labelled, not faked).
# CAPTION_PROVIDER=fixture
# WHISPER_BIN=

# Meilisearch. Unset or down = Postgres search (engine: "postgres").
MEILI_HOST=http://localhost:7700
MEILI_API_KEY=tessera_meili_dev_key_change_me

# Google / Apple are implemented. Leave blank locally — buttons hide and the
# API returns 501 OAUTH_NOT_CONFIGURED rather than a fake login.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# Push. Unset = labelled SOFT-FAIL (devices stored, nothing pretended as sent).
# EXPO_ACCESS_TOKEN=
# PUSH_DRIVER=live
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:noreply@localhost
